# Copie ce fichier en ".env" (jamais envoyé sur GitHub).

# Neon : chaîne « pooled » (avec -pooler dans l'hôte) pour l'application…
DATABASE_URL="postgresql://utilisateur:motdepasse@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# … et chaîne directe (sans -pooler) pour les migrations Prisma.
DIRECT_URL="postgresql://utilisateur:motdepasse@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Clé de signature des sessions, 32 caractères minimum. Pour en générer une :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Adresse du site (liens dans les e-mails).
APP_URL="http://localhost:3000"

# Facultatif : si renseigné, ce code est demandé à l'inscription (inscriptions sur invitation).
REGISTRATION_CODE=""

# Envoi des e-mails par Gmail (mot de passe d'application Google, 16 lettres) :
GMAIL_USER="pronos.rougeetnoir@gmail.com"
GMAIL_APP_PASSWORD="xqvi mrcj kgqg gpsj"
EMAIL_FROM="Rouge & Noir - Pronostics <pronos.rougeetnoir@gmail.com>"

# Ou par Resend (domaine vérifié requis). Sans aucun des deux, le lien s'affiche dans le terminal.
RESEND_API_KEY=""
# Nom affiché de l'expéditeur. Avec Gmail, l'adresse doit être celle de GMAIL_USER.
EMAIL_FROM="Rouge & Noir <ton.adresse@gmail.com>"

# Secret des appels planifiés (Vercel Cron et cron-job.org), 32 caractères minimum.
CRON_SECRET=""

# Saison et équipe suivies (valeurs par défaut : 2026 = saison 2026-2027, 169 = Stade Rennais chez ESPN).
SEASON_START_YEAR="2026"
ESPN_TEAM_ID="169"

# Score maximal proposé dans les menus de pronostic (15 par défaut).
MAX_PREDICTED_GOALS="15"

# Notifications push (facultatif). Générer avec : node scripts/generate-vapid.mjs
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ton-adresse@exemple.fr"

# Photos officielles des joueurs (API-Football, clé gratuite : 1 requête par jour). 94 = Stade Rennais.
API_FOOTBALL_KEY=""
API_FOOTBALL_TEAM_ID="94"
# Intervalle des mises à jour automatiques des photos, en jours (60 = 6 fois par an)
PHOTOS_SYNC_DAYS="60"
